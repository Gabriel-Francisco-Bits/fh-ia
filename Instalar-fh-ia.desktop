[Desktop Entry]
Type=Application
Version=1.0
Name=Instalar fh-ia
GenericName=Instalar extensión fh-ia
Comment=Un clic: descarga e instala fh-ia en VS Code / Cursor
Exec=sh -c 'S="$HOME/Descargas/fh-ia/Instalar-fh-ia.sh"; if [ -x "$S" ]; then exec "$S"; fi; D=$(dirname "$(readlink -f %k 2>/dev/null || echo .)"); if [ -x "$D/Instalar-fh-ia.sh" ]; then exec "$D/Instalar-fh-ia.sh"; fi; curl -fsSL https://raw.githubusercontent.com/Gabriel-Francisco-Bits/fh-ia/main/Instalar-fh-ia.sh | bash'
Icon=applications-development
Terminal=true
Categories=Development;Utility;
StartupNotify=true
Keywords=fh-ia;vscode;grok;claude;cursor;
